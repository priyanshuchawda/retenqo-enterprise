---
import BaseLayout from '../layouts/BaseLayout.astro';
import FeatureIcon from '../components/ui/FeatureIcon.astro';
import { FEATURES, FEATURE_STORIES } from '../data/features';

const USE_CASES = [
  {
    audience: 'Students',
    example:
      'Keep a deadline or reading note from a selected class message findable.',
  },
  {
    audience: 'Professionals',
    example:
      'Recall a meeting detail and review a suggested follow-up before creating a reminder.',
  },
  {
    audience: 'Freelancers',
    example:
      'Keep a client request beside its source and confirm a delivery commitment.',
  },
] as const;
---

<BaseLayout
  title="Features"
  description="Explore Retenqo's privacy-first, on-device AI memory capabilities for Android."
>
  <section class="mx-auto max-w-6xl px-4 py-16 sm:px-6">
    <div class="max-w-2xl">
      <p
        class="text-xs font-semibold tracking-widest text-[var(--accent-primary)] uppercase"
      >
        Capabilities
      </p>
      <h1
        class="mt-3 text-3xl font-bold tracking-tight text-[var(--text-primary)] sm:text-4xl"
      >
        Built for private, reliable recall
      </h1>
      <p class="mt-4 text-base leading-relaxed text-[var(--text-secondary)]">
        Retenqo combines selective capture, local indexing, and on-device AI so
        your personal context stays useful and under your control.
      </p>
    </div>

    <div class="mt-12 grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
      {
        FEATURES.map((feature) => (
          <article class="card-hover rounded-2xl border border-[var(--border-subtle)] bg-[var(--bg-secondary)] p-6">
            <span class="inline-flex h-12 w-12 items-center justify-center rounded-xl bg-[var(--accent-soft)] text-[var(--accent-primary)]">
              <FeatureIcon name={feature.icon} size={26} />
            </span>
            <h2 class="mt-4 text-base font-semibold text-[var(--text-primary)]">
              {feature.title}
            </h2>
            <p class="mt-2 text-sm leading-relaxed text-[var(--text-secondary)]">
              {feature.description}
            </p>
          </article>
        ))
      }
    </div>
  </section>

  <section
    class="mx-auto max-w-6xl px-4 pb-16 sm:px-6"
    aria-labelledby="use-cases"
  >
    <h2 id="use-cases" class="text-2xl font-bold text-[var(--text-primary)]">
      Everyday examples
    </h2>
    <p class="mt-2 text-sm text-[var(--text-secondary)]">
      Illustrative situations with synthetic content; these are not customer
      stories.
    </p>
    <div class="mt-5 grid gap-4 md:grid-cols-3">
      {
        USE_CASES.map((useCase) => (
          <article class="rounded-2xl border border-[var(--border-subtle)] bg-[var(--bg-secondary)] p-5">
            <h3 class="font-semibold text-[var(--text-primary)]">
              {useCase.audience}
            </h3>
            <p class="mt-2 text-sm leading-relaxed text-[var(--text-secondary)]">
              {useCase.example}
            </p>
          </article>
        ))
      }
    </div>
  </section>

  <section class="mx-auto max-w-6xl px-4 pb-16 sm:px-6">
    <div
      class="rounded-3xl border border-[var(--border-subtle)] bg-[var(--bg-secondary)] p-6 sm:p-8"
    >
      <p
        class="text-xs font-semibold tracking-widest text-[var(--accent-primary)] uppercase"
      >
        Try a sample workflow
      </p>
      <h2 class="mt-2 text-2xl font-bold text-[var(--text-primary)]">
        A small example, using synthetic content
      </h2>
      <p class="mt-2 max-w-2xl text-sm text-[var(--text-secondary)]">
        This walkthrough is illustrative. It does not connect to the Android app
        or collect data.
      </p>
      <div class="mt-6 grid gap-4 md:grid-cols-3">
        {
          FEATURE_STORIES.map((story) => (
            <details class="rounded-2xl border border-[var(--border-subtle)] bg-[var(--bg-primary)] p-5">
              <summary class="min-h-11 cursor-pointer font-semibold text-[var(--text-primary)]">
                {story.eyebrow}: {story.title}
              </summary>
              <p class="mt-3 text-sm leading-relaxed text-[var(--text-secondary)]">
                {story.sample}
              </p>
            </details>
          ))
        }
      </div>
    </div>
  </section>

  <section class="mx-auto max-w-6xl px-4 pb-20 sm:px-6">
    <h2 class="text-2xl font-bold text-[var(--text-primary)]">
      A different job from notes or reminders
    </h2>
    <p class="mt-2 max-w-2xl text-sm text-[var(--text-secondary)]">
      Retenqo links selected context to a reviewable follow-through flow; it can
      complement the apps you already use.
    </p>
    <div
      class="mt-6 overflow-x-auto rounded-2xl border border-[var(--border-subtle)]"
      role="region"
      aria-label="Retenqo and traditional notes or reminder apps comparison"
      tabindex="0"
    >
      <table class="w-full min-w-[600px] border-collapse text-left text-sm">
        <thead class="bg-[var(--bg-secondary)] text-[var(--text-primary)]">
          <tr
            ><th scope="col" class="p-4">Need</th><th scope="col" class="p-4"
              >Retenqo</th
            ><th scope="col" class="p-4">Notes app</th><th
              scope="col"
              class="p-4">Reminder app</th
            ></tr
          >
        </thead>
        <tbody
          class="divide-y divide-[var(--border-subtle)] text-[var(--text-secondary)]"
        >
          <tr
            ><th scope="row" class="p-4 font-medium text-[var(--text-primary)]"
              >Keep selected messages and context</th
            ><td class="p-4">Opt-in capture and file import</td><td class="p-4"
              >Usually user-entered</td
            ><td class="p-4">Usually date or task focused</td></tr
          >
          <tr
            ><th scope="row" class="p-4 font-medium text-[var(--text-primary)]"
              >Find personal context later</th
            ><td class="p-4">Local keyword search and Ask</td><td class="p-4"
              >Search notes</td
            ><td class="p-4">Search scheduled items</td></tr
          >
          <tr
            ><th scope="row" class="p-4 font-medium text-[var(--text-primary)]"
              >Turn evidence into a commitment</th
            ><td class="p-4">Review and confirm suggestions</td><td class="p-4"
              >Manual note or checklist</td
            ><td class="p-4">Manual reminder setup</td></tr
          >
        </tbody>
      </table>
    </div>
  </section>
</BaseLayout>
