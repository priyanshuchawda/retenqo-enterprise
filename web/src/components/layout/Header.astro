---
import { SITE_CONFIG } from '../../config/site';

const currentPath = Astro.url.pathname;
---

<header class="sticky top-0 z-40 border-b" style="background: color-mix(in srgb, var(--bg-primary) 92%, transparent); border-color: var(--border-subtle); backdrop-filter: blur(16px); -webkit-backdrop-filter: blur(16px);">
  <div class="mx-auto flex max-w-7xl items-center justify-between px-4 py-3 sm:px-6">
    <!-- Logo -->
    <a href="/" class="flex items-center gap-2.5 text-base font-bold tracking-tight hover:opacity-90"
       style="color: var(--text-primary);" aria-label="Retenqo home">
      <img src="/favicon.svg" alt="" width="30" height="30" class="h-[30px] w-[30px] rounded-lg" />
      <span>retenqo<span style="color: var(--accent-primary);">.</span></span>
    </a>

    <!-- Desktop nav -->
    <nav aria-label="Primary navigation" class="hidden md:flex md:items-center md:gap-1">
      {SITE_CONFIG.nav.map((item) => {
        const isActive = currentPath === item.href || (item.href !== '/' && currentPath.startsWith(item.href));
        const isDownload = item.href === '/download';
        return (
          <a
            href={item.href}
            aria-current={isActive ? 'page' : undefined}
            class={isDownload
              ? 'ml-2 inline-flex min-h-[40px] items-center rounded-lg px-4 py-2 text-sm font-semibold transition-colors'
              : `inline-flex min-h-[40px] items-center rounded-lg px-3 py-2 text-sm font-medium transition-colors ${isActive ? 'font-semibold' : ''}`
            }
            style={isDownload
              ? `background: var(--btn-primary-bg); color: var(--btn-primary-text);`
              : `color: ${isActive ? 'var(--text-primary)' : 'var(--text-secondary)'}; background: ${isActive ? 'var(--bg-tertiary)' : 'transparent'};`
            }
          >
            {item.label}
          </a>
        );
      })}
    </nav>

    <!-- Mobile menu -->
    <details class="relative md:hidden">
      <summary class="inline-flex min-h-[44px] min-w-[44px] cursor-pointer list-none items-center justify-center rounded-lg border text-sm font-medium"
               style="border-color: var(--border-subtle); background: var(--bg-secondary); color: var(--text-primary);"
               aria-label="Toggle navigation menu">
        ☰
      </summary>
      <nav aria-label="Mobile navigation"
           class="absolute right-0 mt-2 w-56 rounded-2xl border p-2 shadow-xl"
           style="border-color: var(--border-subtle); background: var(--bg-secondary);">
        <ul class="flex flex-col gap-1" role="list">
          {SITE_CONFIG.nav.map((item) => {
            const isActive = currentPath === item.href;
            return (
              <li>
                <a href={item.href}
                   aria-current={isActive ? 'page' : undefined}
                   class="flex min-h-[44px] items-center rounded-xl px-3 py-2 text-sm font-medium"
                   style={`color: ${isActive ? 'var(--text-primary)' : 'var(--text-secondary)'}; background: ${isActive ? 'var(--bg-tertiary)' : 'transparent'};`}>
                  {item.label}
                </a>
              </li>
            );
          })}
        </ul>
      </nav>
    </details>
  </div>
</header>
