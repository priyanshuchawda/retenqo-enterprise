---
import SectionHeading from '../ui/SectionHeading.astro';
import FeatureIcon from '../ui/FeatureIcon.astro';
import { FEATURE_STORIES } from '../../data/features';
---

<section class="py-20 sm:py-28" style="background: var(--bg-primary);">
  <div class="mx-auto max-w-7xl px-4 sm:px-6">
    <div
      class="flex flex-col gap-4 sm:flex-row sm:items-end sm:justify-between"
    >
      <SectionHeading
        eyebrow="A clear path from context to action"
        heading="Capture. Remember. Follow through."
        subheading="Three practical steps keep personal context useful while the important choices remain yours."
      />
      <a
        href="/features"
        class="shrink-0 text-sm font-semibold transition-colors hover:opacity-80"
        style="color: var(--accent-primary);"
      >
        Explore all features →
      </a>
    </div>

    <div class="mt-12 grid gap-5 lg:grid-cols-3">
      {
        FEATURE_STORIES.map((story) => (
          <article
            class="flex flex-col rounded-3xl border p-6 sm:p-8"
            style="border-color: var(--border-subtle); background: var(--bg-secondary);"
          >
            <p
              class="text-xs font-semibold tracking-widest uppercase"
              style="color: var(--accent-primary);"
            >
              {story.eyebrow}
            </p>
            <div
              class="mt-6 inline-flex h-14 w-14 items-center justify-center rounded-2xl"
              style="background: var(--accent-soft); color: var(--accent-primary);"
            >
              <FeatureIcon name={story.icon} size={30} />
            </div>
            <h3
              class="mt-6 text-xl font-semibold"
              style="color: var(--text-primary);"
            >
              {story.title}
            </h3>
            <p
              class="mt-3 flex-1 text-sm leading-relaxed"
              style="color: var(--text-secondary);"
            >
              {story.body}
            </p>
            <div
              class="mt-6 rounded-2xl border p-4"
              style="border-color: var(--border-subtle); background: var(--bg-primary);"
            >
              <p
                class="text-[11px] font-semibold tracking-wider uppercase"
                style="color: var(--text-muted);"
              >
                Illustrative sample
              </p>
              <p
                class="mt-2 text-sm leading-relaxed"
                style="color: var(--text-primary);"
              >
                {story.sample}
              </p>
            </div>
          </article>
        ))
      }
    </div>
  </div>
</section>
