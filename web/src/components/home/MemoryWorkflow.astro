---
import SectionHeading from '../ui/SectionHeading.astro';
import Button from '../ui/Button.astro';

const steps = [
  {
    num: '01',
    title: 'Someone asks you for something',
    quote: '"Can you send me the slides by Friday?"',
    desc: 'Retenqo captures the notification from an app you have opted in.',
  },
  {
    num: '02',
    title: 'On-device AI understands it',
    desc: 'Local inference extracts a commitment, deadline, and the person who asked — without leaving your device.',
  },
  {
    num: '03',
    title: 'You review and accept',
    desc: 'The commitment shows the original source so you can verify it before confirming.',
  },
  {
    num: '04',
    title: 'Retenqo remembers',
    desc: 'The accepted task appears with its due date and a reminder — all locally stored.',
  },
  {
    num: '05',
    title: 'You follow through',
    desc: 'Later evidence can suggest completion for your review and approval.',
  },
];
---

<section
  class="relative overflow-hidden py-20 sm:py-28"
  style="background: var(--bg-secondary);"
>
  <div
    class="pointer-events-none absolute inset-0 glow-bg-teal"
    aria-hidden="true"
  >
  </div>
  <div class="relative mx-auto max-w-7xl px-4 sm:px-6">
    <SectionHeading
      eyebrow="More than memory"
      heading="Meaningful action, not just recall."
      subheading="Retenqo follows the entire lifecycle of a commitment — from capture to completion — privately on your phone."
    />

    <div class="mt-12 relative">
      <!-- Connecting line -->
      <div
        class="absolute left-[22px] top-8 bottom-8 w-px hidden sm:block"
        style="background: linear-gradient(to bottom, var(--accent-primary), var(--accent-secondary));"
        aria-hidden="true"
      >
      </div>

      <ol class="space-y-6">
        {
          steps.map((step) => (
            <li class="relative flex gap-6">
              <div
                class="relative z-10 flex h-11 w-11 shrink-0 items-center justify-center rounded-full border-2 text-xs font-bold"
                style={`border-color: var(--accent-primary); background: var(--bg-secondary); color: var(--accent-primary);`}
              >
                {step.num}
              </div>
              <div
                class="card-hover flex-1 rounded-2xl border p-5 sm:p-6"
                style="border-color: var(--border-subtle); background: var(--bg-primary);"
              >
                <h3
                  class="text-base font-semibold sm:text-lg"
                  style="color: var(--text-primary);"
                >
                  {step.title}
                </h3>
                {step.quote && (
                  <blockquote
                    class="mt-2 rounded-xl border-l-4 pl-3 py-1 text-sm italic"
                    style="border-color: var(--accent-secondary); color: var(--text-secondary);"
                  >
                    {step.quote}
                  </blockquote>
                )}
                <p
                  class="mt-2 text-sm leading-relaxed"
                  style="color: var(--text-secondary);"
                >
                  {step.desc}
                </p>
              </div>
            </li>
          ))
        }
      </ol>
    </div>

    <div class="mt-12 flex justify-center">
      <Button href="/how-it-works" variant="secondary" size="md">
        Read the full architecture →
      </Button>
    </div>
  </div>
</section>
