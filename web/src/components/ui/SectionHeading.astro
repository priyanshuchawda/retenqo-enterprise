---
export interface Props {
  eyebrow?: string;
  heading: string;
  subheading?: string;
  align?: 'left' | 'center';
  headingLevel?: 1 | 2;
}
const {
  eyebrow,
  heading,
  subheading,
  align = 'left',
  headingLevel = 2,
} = Astro.props;
const centered = align === 'center';
const headingClass = 'text-3xl font-bold tracking-tight sm:text-4xl';
const headingStyle = 'color: var(--text-primary);';
---

<div class={centered ? 'text-center' : ''}>
  {
    eyebrow && (
      <p
        class={`mb-3 text-xs font-bold tracking-widest uppercase ${centered ? '' : ''}`}
        style="color: var(--accent-primary);"
      >
        {eyebrow}
      </p>
    )
  }
  {
    headingLevel === 1 ? (
      <h1 class={headingClass} style={headingStyle}>
        {heading}
      </h1>
    ) : (
      <h2 class={headingClass} style={headingStyle}>
        {heading}
      </h2>
    )
  }
  {
    subheading && (
      <p
        class={`mt-4 text-base leading-relaxed sm:text-lg ${centered ? 'mx-auto max-w-2xl' : 'max-w-2xl'}`}
        style="color: var(--text-secondary);"
      >
        {subheading}
      </p>
    )
  }
</div>
