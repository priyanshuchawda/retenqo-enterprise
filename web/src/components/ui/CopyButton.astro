---
interface Props {
  readonly value: string;
  readonly label: string;
}

const { value, label } = Astro.props;
---

<span class="copy-control inline-flex items-center gap-2">
  <button
    type="button"
    class="inline-flex min-h-11 min-w-11 items-center justify-center rounded-lg border"
    style="border-color: var(--border-subtle); background: var(--bg-tertiary); color: var(--text-primary);"
    data-copy-value={value}
    aria-label={`Copy ${label}`}
  >
    <svg
      viewBox="0 0 24 24"
      width="18"
      height="18"
      fill="none"
      aria-hidden="true"
    >
      <rect
        x="8"
        y="8"
        width="11"
        height="12"
        rx="2"
        stroke="currentColor"
        stroke-width="1.8"></rect>
      <path
        d="M16 8V6a2 2 0 0 0-2-2H6a2 2 0 0 0-2 2v10a2 2 0 0 0 2 2h2"
        stroke="currentColor"
        stroke-width="1.8"></path>
    </svg>
  </button>
  <span class="text-xs" style="color: var(--text-muted);" role="status"></span>
</span>
