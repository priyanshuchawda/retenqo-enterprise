---
import BaseLayout from '../layouts/BaseLayout.astro';

interface Feature {
  icon: string;
  title: string;
  description: string;
}

const features: readonly Feature[] = [
  {
    icon: '🔔',
    title: 'Opt-in Notification Capture',
    description:
      'Selectively capture important messages and alerts from apps you choose. You can exclude sensitive apps or pause capture anytime in settings.',
  },
  {
    icon: '📷',
    title: 'Screenshot Understanding',
    description:
      'On-device OCR extracts text, dates, and key details from screenshots without sending them to a server.',
  },
  {
    icon: '🎙️',
    title: 'Voice-to-Memory',
    description:
      'Record a voice note and convert it into a structured, searchable memory — transcribed locally on-device.',
  },
  {
    icon: '🧠',
    title: 'Local AI Assistant',
    description:
      'Ask natural language questions and get answers generated entirely on your Android device, offline.',
  },
  {
    icon: '🔗',
    title: 'Source-Referenced Answers',
    description:
      'AI answers reference the specific saved memory they were derived from, so you can review the original context.',
  },
  {
    icon: '✅',
    title: 'Commitment Tracking & Smart Reminders',
    description:
      'Surface upcoming deadlines and turn confirmed commitments into smart local reminders.',
  },
  {
    icon: '🔑',
    title: 'Encrypted Backup Exports',
    description:
      'Export and restore your memory database with password-protected encryption. Your backup key stays on your device.',
  },
  {
    icon: '🛡️',
    title: 'Granular Privacy Controls',
    description:
      'Inspect, edit, or permanently delete any stored memory at any time. Includes full local wipe.',
  },
  {
    icon: '📴',
    title: 'Offline-First Processing',
    description:
      'Core capture, local search, and on-device AI inference work without an internet connection.',
  },
];
---

<BaseLayout
  title="Features"
  description="Explore Retenqo's privacy-first, on-device AI memory capabilities for Android."
>
  <section class="mx-auto max-w-6xl px-4 py-16 sm:px-6">
    <div class="max-w-2xl">
      <p
        class="text-xs font-semibold tracking-widest text-[var(--accent-primary)] uppercase"
      >
        Capabilities
      </p>
      <h1
        class="mt-3 text-3xl font-bold tracking-tight text-[var(--text-primary)] sm:text-4xl"
      >
        Built for private, reliable recall
      </h1>
      <p class="mt-4 text-base leading-relaxed text-[var(--text-secondary)]">
        Retenqo combines selective capture, local indexing, and on-device AI so
        your personal context stays useful and under your control.
      </p>
    </div>

    <div class="mt-12 grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
      {
        features.map((feature) => (
          <article class="card-hover rounded-2xl border border-[var(--border-subtle)] bg-[var(--bg-secondary)] p-6">
            <span class="text-2xl" aria-hidden="true">{feature.icon}</span>
            <h2 class="mt-4 text-base font-semibold text-[var(--text-primary)]">
              {feature.title}
            </h2>
            <p class="mt-2 text-sm leading-relaxed text-[var(--text-secondary)]">
              {feature.description}
            </p>
          </article>
        ))
      }
    </div>
  </section>
</BaseLayout>
