---
export interface Props {
  href?: string;
  variant?: 'primary' | 'secondary';
  size?: 'sm' | 'md' | 'lg';
  type?: 'button' | 'submit';
  disabled?: boolean;
  class?: string;
}

const {
  href,
  variant = 'primary',
  size = 'md',
  type = 'button',
  disabled = false,
  class: extraClass = '',
} = Astro.props;

const baseClasses =
  'inline-flex items-center justify-center gap-2 rounded-xl font-semibold transition-colors focus-visible:outline-2 focus-visible:outline-offset-2';

const sizeClasses = {
  sm: 'min-h-[44px] px-4 py-2 text-sm',
  md: 'min-h-[44px] px-5 py-2.5 text-sm',
  lg: 'min-h-[48px] px-6 py-3 text-base',
}[size];

const variantClasses = disabled
  ? 'cursor-not-allowed bg-[var(--bg-tertiary)] text-[var(--text-muted)]'
  : variant === 'primary'
    ? 'bg-[var(--btn-primary-bg)] text-[var(--btn-primary-text)] hover:bg-[var(--btn-primary-hover)]'
    : 'border border-[var(--border-subtle)] bg-[var(--bg-secondary)] text-[var(--text-primary)] hover:bg-[var(--bg-tertiary)]';

const classes =
  `${baseClasses} ${sizeClasses} ${variantClasses} ${extraClass}`.trim();
---

{
  href && !disabled ? (
    <a href={href} class={classes}>
      <slot />
    </a>
  ) : (
    <button type={type} disabled={disabled} class={classes}>
      <slot />
    </button>
  )
}
