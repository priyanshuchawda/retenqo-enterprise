---
import BaseLayout from '../layouts/BaseLayout.astro';
import { SITE_CONFIG } from '../config/site';
import Button from '../components/ui/Button.astro';
import SectionHeading from '../components/ui/SectionHeading.astro';
import releaseData from '../data/release.generated.json';
import { formatBytes, parseReleaseState } from '../lib/releases/validation';

const state = parseReleaseState(releaseData);
---

<BaseLayout
  title="Download Retenqo for Android"
  description="Official Android APK distribution for Retenqo with SHA-256 checksum. Direct from GitHub Releases."
>
  <section class="mx-auto max-w-4xl px-4 py-16 sm:px-6">
    <SectionHeading
      eyebrow="Official Application Distribution"
      heading="Retenqo for Android"
      subheading="All APK builds are distributed directly from official GitHub Releases. No intermediate proxy."
    />

    <div
      class="mt-10 rounded-3xl border p-6 sm:p-8"
      style="border-color: var(--border-subtle); background: var(--bg-secondary);"
    >
      {
        state.status === 'pending' ? (
          <div>
            <span
              class="inline-flex items-center gap-2 rounded-full border px-3 py-1 text-xs font-semibold"
              style="border-color: var(--border-subtle); background: var(--bg-tertiary); color: var(--text-muted);"
            >
              ⏳ Awaiting first release
            </span>

            <dl class="mt-6 grid gap-4 sm:grid-cols-2">
              {[
                ['Version', 'Pending release'],
                ['APK size', 'Pending release'],
                ['SHA-256 checksum', 'Available after publication'],
                ['Signing certificate', 'Available after verification'],
                ['Min. Android', 'Android 13 (API 33)'],
                ['Architecture', 'arm64-v8a'],
              ].map(([dt, dd]) => (
                <div
                  class="rounded-2xl border p-4"
                  style="border-color: var(--border-subtle); background: var(--bg-primary);"
                >
                  <dt
                    class="text-xs font-medium"
                    style="color: var(--text-muted);"
                  >
                    {dt}
                  </dt>
                  <dd
                    class="mt-1 text-sm font-semibold"
                    style="color: var(--text-primary);"
                  >
                    {dd}
                  </dd>
                </div>
              ))}
            </dl>

            <div class="mt-8 flex flex-wrap gap-4">
              <button
                type="button"
                disabled
                class="inline-flex min-h-[48px] cursor-not-allowed items-center gap-2 rounded-xl px-6 py-3 text-sm font-semibold"
                style="background: var(--bg-tertiary); color: var(--text-muted);"
              >
                Download APK — Coming soon
              </button>
              <Button
                href={SITE_CONFIG.appReleasesUrl}
                variant="secondary"
                size="lg"
              >
                View official GitHub Releases ↗
              </Button>
            </div>
            <p class="mt-4 text-xs" style="color: var(--text-muted);">
              The download becomes available automatically once a valid, signed
              public release is published.
            </p>
          </div>
        ) : (
          <div>
            <span
              class="inline-flex items-center gap-2 rounded-full border px-3 py-1 text-xs font-semibold"
              style="border-color: var(--accent-primary); background: var(--accent-soft); color: var(--accent-primary);"
            >
              ✓ Release {state.release.version}
            </span>

            <dl class="mt-6 grid gap-4 sm:grid-cols-2">
              <div
                class="rounded-2xl border p-4"
                style="border-color: var(--border-subtle); background: var(--bg-primary);"
              >
                <dt
                  class="text-xs font-medium"
                  style="color: var(--text-muted);"
                >
                  Version
                </dt>
                <dd
                  class="mt-1 text-sm font-semibold"
                  style="color: var(--text-primary);"
                >
                  {state.release.version}
                </dd>
              </div>
              <div
                class="rounded-2xl border p-4"
                style="border-color: var(--border-subtle); background: var(--bg-primary);"
              >
                <dt
                  class="text-xs font-medium"
                  style="color: var(--text-muted);"
                >
                  APK size
                </dt>
                <dd
                  class="mt-1 text-sm font-semibold"
                  style="color: var(--text-primary);"
                >
                  {formatBytes(state.release.apkSizeBytes)}
                </dd>
              </div>
              <div
                class="rounded-2xl border p-4 sm:col-span-2"
                style="border-color: var(--border-subtle); background: var(--bg-primary);"
              >
                <dt
                  class="text-xs font-medium"
                  style="color: var(--text-muted);"
                >
                  SHA-256 checksum
                </dt>
                <dd
                  class="mt-1 break-all font-mono text-xs"
                  style="color: var(--text-primary);"
                >
                  {state.release.sha256}
                </dd>
              </div>
              <div
                class="rounded-2xl border p-4"
                style="border-color: var(--border-subtle); background: var(--bg-primary);"
              >
                <dt
                  class="text-xs font-medium"
                  style="color: var(--text-muted);"
                >
                  Min. Android
                </dt>
                <dd
                  class="mt-1 text-sm font-semibold"
                  style="color: var(--text-primary);"
                >
                  Android 13 (API {state.release.minimumAndroidApi})
                </dd>
              </div>
              <div
                class="rounded-2xl border p-4"
                style="border-color: var(--border-subtle); background: var(--bg-primary);"
              >
                <dt
                  class="text-xs font-medium"
                  style="color: var(--text-muted);"
                >
                  Architecture
                </dt>
                <dd
                  class="mt-1 text-sm font-semibold"
                  style="color: var(--text-primary);"
                >
                  {state.release.architectures.join(', ')}
                </dd>
              </div>
            </dl>

            <div class="mt-8 flex flex-wrap gap-4">
              <Button href={state.release.apkUrl} variant="primary" size="lg">
                ⬇ Download Official APK ({state.release.version})
              </Button>
              <Button
                href={state.release.releaseUrl}
                variant="secondary"
                size="lg"
              >
                Release Notes ↗
              </Button>
            </div>
          </div>
        )
      }
    </div>

    <!-- Verification section -->
    <section
      class="mt-10 rounded-3xl border p-6"
      style="border-color: var(--border-subtle); background: var(--bg-secondary);"
    >
      <h2 class="text-lg font-semibold" style="color: var(--text-primary);">
        Verify your download
      </h2>
      <p class="mt-2 text-sm" style="color: var(--text-secondary);">
        After downloading, compare the SHA-256 hash and verify the APK signature
        independently:
      </p>
      <div class="mt-5 space-y-4 text-xs">
        {
          [
            {
              label: 'Windows PowerShell',
              code: 'Get-FileHash .\\Retenqo.apk -Algorithm SHA256',
            },
            { label: 'Linux / macOS', code: 'sha256sum Retenqo.apk' },
            {
              label: 'Android SDK (apksigner)',
              code: 'apksigner verify --verbose --print-certs Retenqo.apk',
            },
          ].map(({ label, code }) => (
            <div>
              <p class="mb-1 font-semibold" style="color: var(--text-primary);">
                {label}
              </p>
              <pre
                class="overflow-x-auto rounded-xl border p-3 font-mono leading-relaxed"
                style="border-color: var(--border-subtle); background: var(--bg-primary); color: var(--text-secondary);"
              >
                <code>{code}</code>
              </pre>
            </div>
          ))
        }
      </div>
    </section>

    <!-- Installation link -->
    <p class="mt-6 text-sm text-center" style="color: var(--text-muted);">
      First time installing an APK?
      <a
        href="/installation"
        class="font-semibold underline underline-offset-2 hover:opacity-80"
        style="color: var(--accent-primary);"
      >
        Read the safe installation guide →
      </a>
    </p>
  </section>
</BaseLayout>
