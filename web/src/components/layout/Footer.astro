---
import { SITE_CONFIG } from '../../config/site';

const year = new Date().getFullYear();
const links = [
  {
    heading: 'Product',
    items: [
      { label: 'Features', href: '/features' },
      { label: 'How It Works', href: '/how-it-works' },
      { label: 'Download', href: '/download' },
      { label: 'Installation', href: '/installation' },
      { label: 'FAQ', href: '/faq' },
    ],
  },
  {
    heading: 'Trust',
    items: [
      { label: 'Privacy Policy', href: '/privacy' },
      { label: 'Security', href: '/security' },
      { label: 'Android Permissions', href: '/permissions' },
      { label: 'Accessibility', href: '/accessibility' },
    ],
  },
  {
    heading: 'Open Source',
    items: [
      {
        label: 'GitHub Repository',
        href: SITE_CONFIG.appRepoUrl,
        external: true,
      },
      {
        label: 'GitHub Releases',
        href: SITE_CONFIG.appReleasesUrl,
        external: true,
      },
      { label: 'Website Source', href: SITE_CONFIG.webRepoUrl, external: true },
      { label: 'Support & Bugs', href: '/support' },
    ],
  },
];
---

<footer
  class="border-t"
  style="border-color: var(--border-subtle); background: var(--bg-secondary);"
>
  <div class="mx-auto max-w-7xl px-4 py-14 sm:px-6">
    <div class="grid gap-10 sm:grid-cols-2 lg:grid-cols-4">
      <!-- Brand -->
      <div>
        <a
          href="/"
          class="flex items-center gap-2 text-base font-bold"
          style="color: var(--text-primary);"
        >
          <img
            src="/favicon.svg"
            alt=""
            width="26"
            height="26"
            class="h-[26px] w-[26px] rounded-lg"
          />
          <span
            >retenqo<span style="color: var(--accent-primary);">.</span></span
          >
        </a>
        <p
          class="mt-3 text-sm leading-relaxed"
          style="color: var(--text-secondary);"
        >
          Private, on-device AI memory assistant for Android. No tracking
          cookies. No cloud lock-in. Apache 2.0.
        </p>
        <a
          href={SITE_CONFIG.appReleasesUrl}
          target="_blank"
          rel="noopener noreferrer"
          class="mt-4 inline-flex min-h-[36px] items-center gap-1.5 rounded-lg border px-3 py-1.5 text-xs font-semibold transition-colors hover:opacity-80"
          style="border-color: var(--border-subtle); background: var(--bg-tertiary); color: var(--text-primary);"
        >
          ⬇ Download APK
        </a>
      </div>

      {
        links.map(({ heading, items }) => (
          <div>
            <h2
              class="text-xs font-bold tracking-widest uppercase"
              style="color: var(--text-primary);"
            >
              {heading}
            </h2>
            <ul class="mt-4 space-y-2.5" role="list">
              {items.map(({ label, href, external }) => (
                <li>
                  <a
                    href={href}
                    {...(external
                      ? { target: '_blank', rel: 'noopener noreferrer' }
                      : {})}
                    class="text-sm transition-colors hover:opacity-90"
                    style="color: var(--text-secondary);"
                  >
                    {label}
                  </a>
                </li>
              ))}
            </ul>
          </div>
        ))
      }
    </div>

    <div
      class="mt-12 flex flex-col items-start justify-between gap-4 border-t pt-6 text-xs sm:flex-row sm:items-center"
      style="border-color: var(--border-subtle); color: var(--text-muted);"
    >
      <p>&copy; {year} Retenqo. Privacy-first engineering.</p>
      <p>Static site · Zero tracking · Apache 2.0</p>
    </div>
  </div>
</footer>
